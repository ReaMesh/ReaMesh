{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReaMesh Setup",
  "mainBinaryName": "reamesh-setup",
  "version": "../app/package.json",
  "identifier": "com.reamesh.setup",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../app/dist-setup"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../proprietary/icons/icon.ico"],
    "publisher": "ReaMesh",
    "copyright": "ReaMesh contributors, GPL-3.0"
  }
}
