{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReaMesh",
  "version": "0.1.0",
  "identifier": "app.reamesh.companion",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ReaMesh",
        "width": 420,
        "height": 660,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 19,
          "y": 18
        },
        "backgroundColor": "#101013"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../extension/build/reaper_reamesh.dylib": "reaper_reamesh.dylib"
    },
    "macOS": {
      "files": {
        "Resources/Assets.car": "resources/Assets.car"
      }
    }
  }
}
