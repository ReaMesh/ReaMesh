{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReaMesh",
  "version": "1.0.0",
  "identifier": "com.reamesh.ReaMesh",
  "build": {
    "beforeDevCommand": "bun scripts/check-extension.ts --warn && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun scripts/check-extension.ts && bun scripts/gen-credits.ts && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ReaMesh",
        "width": 420,
        "height": 660,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#101013",
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:47415 ws://127.0.0.1:47416 ws://127.0.0.1:47417 ws://127.0.0.1:47418",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:47415 ws://127.0.0.1:47416 ws://127.0.0.1:47417 ws://127.0.0.1:47418 ws://localhost:* http://localhost:*",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5QTA5RTlBMTJEQjhDN0EKUldSNmpOc1NtcDZncVhaM3RoUzF1TUNDZ2JlSmw5dWVjR3R2U1lSbEEyd0pYOG5tN0pwOUNDQlkK",
      "endpoints": [
        "https://github.com/ReaMesh/ReaMesh/releases/download/updater/beta.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["reamesh"]
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "../../proprietary/icons/32x32.png",
      "../../proprietary/icons/128x128.png",
      "../../proprietary/icons/128x128@2x.png",
      "../../proprietary/icons/icon.icns",
      "../../proprietary/icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "files": {
        "Resources/Assets.car": "../../proprietary/icons/Assets.car",
        "Resources/de.lproj/InfoPlist.strings": "de.lproj/InfoPlist.strings"
      },
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    }
  }
}
