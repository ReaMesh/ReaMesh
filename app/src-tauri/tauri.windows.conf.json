{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "ReaMesh",
        "width": 420,
        "height": 660,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#101013"
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "resources": {
      "../../extension/build/Release/reaper_reamesh.dll": "reaper_reamesh.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
