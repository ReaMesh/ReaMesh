{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "ReaMesh",
        "width": 420,
        "height": 660,
        "minWidth": 380,
        "minHeight": 520,
        "maxWidth": 560,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "backgroundColor": "#101013",
        "visible": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "appimage",
      "deb"
    ],
    "resources": {
      "../../extension/build/reaper_reamesh.so": "reaper_reamesh.so"
    },
    "linux": {
      "deb": {
        "section": "sound"
      }
    }
  }
}
